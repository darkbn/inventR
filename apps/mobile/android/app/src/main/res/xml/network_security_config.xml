<?xml version="1.0" encoding="utf-8"?>
<!--
  Politique réseau.

  Le trafic en clair est autorisé uniquement vers les plages d'adresses
  privées : c'est le cas d'un serveur InventAir hébergé sur le réseau local de
  l'entrepôt, souvent sans certificat TLS. Partout ailleurs — donc dès qu'on
  sort du site — HTTPS est obligatoire.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- 10.0.0.0/8 -->
        <domain includeSubdomains="true">10.0.0.0</domain>
        <!-- Hôte de l'émulateur Android -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- 172.16.0.0/12 -->
        <domain includeSubdomains="true">172.16.0.0</domain>
        <!-- 192.168.0.0/16 -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <!-- Boucle locale -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!--
      EXCEPTION TEMPORAIRE — à retirer.

      Accès au serveur depuis l'extérieur, en attendant la mise en service de
      HTTPS. Contrairement aux plages privées ci-dessus, ce domaine est joignable
      depuis Internet : le mot de passe de connexion et les jetons JWT circulent
      ici en clair, lisibles par tout intermédiaire réseau.

      À supprimer dès que le domaine est servi en HTTPS (cf. docs/deploiement.md) :
      la configuration de base impose alors TLS, sans aucune autre modification.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">aajaymi.ddns.net</domain>
    </domain-config>
</network-security-config>
