# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
*.tsbuildinfo

# Environnement — ne JAMAIS committer de secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Tests
coverage/
.nyc_output/

# Données applicatives : fichiers déposés, rapports générés, sauvegardes.
#
# Chemins ANCRÉS, et c'est essentiel : un motif sans barre oblique initiale
# s'applique à tous les niveaux de l'arborescence. Écrit « reports/ », il
# excluait aussi `apps/api/src/modules/reports` — du code source absent du
# dépôt sans que rien ne le signale, et une API qui ne compile pas au clonage.
/storage/
/uploads/
/reports/

# Répertoire d'exécution de l'API (STORAGE_UPLOAD_DIR, STORAGE_REPORT_DIR) :
# fichiers clients déposés et rapports générés. Exclu explicitement, puisque
# les motifs ci-dessus ne visent plus que la racine.
apps/api/storage/

# Flutter / Android
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/debug/
apps/mobile/android/app/profile/
apps/mobile/android/app/release/
apps/mobile/ios/

# Signature Android — secrets, jamais versionnés
**/key.properties
*.jks
*.keystore

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Réglages locaux de l'outillage, propres au poste
.claude/settings.local.json

# Données client réelles : extraction SAP, quantités et prix. Jamais versées au dépôt.
# Les tests qui s'en servent se désactivent proprement en son absence.
samples/*
!samples/README.md
