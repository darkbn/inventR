# ------------------------------------------------------------------------------
# InventAir — variables d'environnement
# Copier en .env puis remplacer TOUTES les valeurs marquées CHANGEME.
# Le fichier .env n'est jamais versionné (cf. .gitignore).
# ------------------------------------------------------------------------------

# --- Général ------------------------------------------------------------------
NODE_ENV=development
TZ=Africa/Algiers

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=inventair
POSTGRES_PASSWORD=CHANGEME_postgres_password
POSTGRES_DB=inventair
# Port exposé sur l'hôte en développement. Utilisez une valeur libre (ex. 55432) si
# une instance PostgreSQL tourne déjà localement sur 5432.
POSTGRES_PORT=5432
# Schéma dédié : Prisma crée et utilise le schéma passé en paramètre.
DATABASE_URL=postgresql://inventair:CHANGEME_postgres_password@localhost:5432/inventair?schema=inventory
# Base utilisée par les tests d'intégration. Si elle n'est pas définie, elle est
# dérivée de DATABASE_URL en suffixant le nom de la base par « _test ». Les tests
# TRONQUENT cette base : elle ne doit jamais désigner une base de travail.
# DATABASE_URL_TEST=postgresql://inventair:CHANGEME_postgres_password@localhost:5432/inventair_test?schema=inventory

# --- API ----------------------------------------------------------------------
API_PORT=3000
API_PREFIX=api/v1
# Origines autorisées par le CORS, séparées par des virgules. Jamais "*" en production.
CORS_ORIGINS=http://localhost:5273,http://localhost:4173

# --- JWT ----------------------------------------------------------------------
# Générer avec : openssl rand -base64 48   (deux secrets DIFFÉRENTS)
JWT_ACCESS_SECRET=CHANGEME_access_secret_min_32_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGEME_refresh_secret_min_32_caracteres
JWT_REFRESH_TTL=7d

# --- Rate limiting (fenêtre en ms / nombre de requêtes) -----------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Limite spécifique au login (anti bruteforce)
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10

# --- Stockage fichiers (volumes Docker en production) -------------------------
STORAGE_UPLOAD_DIR=./storage/uploads
STORAGE_REPORT_DIR=./storage/reports
UPLOAD_MAX_FILE_SIZE_MB=25

# --- Logs ---------------------------------------------------------------------
LOG_LEVEL=debug
# true = logs lisibles en dev ; false = JSON structuré (production)
LOG_PRETTY=true

# --- Seed initial -------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@inventair.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FULLNAME=Administrateur InventAir
SEED_ADMIN_PASSWORD=CHANGEME_mot_de_passe_admin
# Magasin créé au seed (repris du fichier client de référence)
SEED_WAREHOUSE_CODE=19R01
SEED_WAREHOUSE_LABEL=MAGASIN PDR BOUFARIK
# Jeu de données de démonstration (articles/campagne fictifs) : jamais en production
SEED_DEMO_DATA=false

# --- Frontend web -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Sauvegardes PostgreSQL ---------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./storage/backups

# --- pgAdmin (profil "dev" uniquement, jamais exposé en production) -----------
PGADMIN_EMAIL=admin@inventair.local
PGADMIN_PASSWORD=CHANGEME_pgadmin_password
PGADMIN_PORT=5050

# ==============================================================================
# PRODUCTION — variables utilisées uniquement par docker-compose.prod.yml
# ==============================================================================

# Nom de domaine public. Il doit déjà pointer (A/AAAA) vers ce serveur AVANT
# de demander un certificat : Let's Encrypt valide par requête HTTP.
PUBLIC_DOMAIN=inventair.exemple.dz
# Adresse recevant les avis d'expiration de certificat.
LETSENCRYPT_EMAIL=ops@exemple.dz

# Seed joué au démarrage de l'API. À mettre à true pour le TOUT PREMIER
# démarrage (création du compte administrateur), puis à repasser à false.
RUN_SEED_ON_START=false

# Période entre deux sauvegardes, en secondes (86400 = une fois par jour).
BACKUP_INTERVAL_SECONDS=86400
